
# LiveKit inference gateway — required for livekit/* eval models
# (livekit/google/gemma-4-31b-it, livekit/openai/gpt-4o-mini)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=   # if routing any role to anthropic/*

# Typed-decision router (see docs/11-typed-decision-router.md). Unset URL = off.
DECISION_ROUTER_URL=
DECISION_ROUTER_MODEL=
DECISION_ROUTER_API_KEY=
DECISION_ROUTER_MODE=shadow
DECISION_ROUTER_MIN_PROB=0.6
DECISION_ROUTER_TIMEOUT=1.5
